{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-art-creator.local/schemas/artifact.schema.json",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "artifact_id",
    "scene_id",
    "path",
    "owner",
    "revision",
    "sha256",
    "inputs"
  ],
  "additionalProperties": false
}
