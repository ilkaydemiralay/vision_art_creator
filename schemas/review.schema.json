{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-art-creator.local/schemas/review.schema.json",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "passed",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "approver_role": {
      "enum": [
        "director",
        "user",
        "coordinator",
        "reviewer"
      ]
    }
  },
  "required": [
    "review_id",
    "gate",
    "reviewer_id",
    "reviewed_at",
    "subjects",
    "checks",
    "verdict",
    "notes"
  ],
  "additionalProperties": false
}
