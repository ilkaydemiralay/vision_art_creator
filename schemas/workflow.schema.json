{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-art-creator.local/schemas/workflow.schema.json",
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "output": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "artifact_id",
              "path"
            ],
            "additionalProperties": false
          },
          "gate": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "owner",
          "needs",
          "output",
          "gate"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "prefix",
          "owner"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "workflow_id",
    "nodes",
    "ownership"
  ],
  "additionalProperties": false
}
